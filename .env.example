APP_NAME="PageJaunes Mailer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:8081,127.0.0.1,127.0.0.1:8081,::1,emailer.pagesjaunes-dz.com"

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production/staging database is MySQL 8 (docs/48-deploy-runbook.md). Local
# dev may use MariaDB 10.11 with the same mysql driver; the suite is green on
# both. Create the database as utf8mb4 / utf8mb4_unicode_ci.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pagejaunes_mailer
DB_USERNAME=root
DB_PASSWORD=

# First administrator, used by `php artisan db:seed` in production only.
# Leave the password empty to have a random one generated and printed once.
SUPER_ADMIN_EMAIL=admin@pagejaunes.dz
SUPER_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production/staging: QUEUE_CONNECTION=redis, CACHE_STORE=redis
# (docs/02-system-architecture.md §2.7, docs/24-queue-management.md).
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pagejaunes-mailer.local"
MAIL_FROM_NAME="${APP_NAME}"

# External PageJaunes directory database (docs/06-pagejaunes-integration.md).
# Read-only MySQL/MariaDB connection — not used until the PageJaunes
# Integration module is implemented.
PAGEJAUNES_DB_HOST=127.0.0.1
PAGEJAUNES_DB_PORT=3307
PAGEJAUNES_DB_DATABASE=pjnewdb
PAGEJAUNES_DB_USERNAME=root
PAGEJAUNES_DB_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
