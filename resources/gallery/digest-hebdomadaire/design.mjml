<mjml lang="fr">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif"></mj-all>
      <mj-text color="#242424" font-size="14px" line-height="1.5"></mj-text>
      <mj-section background-color="#FFFFFF"></mj-section>
      <mj-button background-color="#2B579A" color="#FFFFFF" border-radius="4px" font-weight="600"></mj-button>
    </mj-attributes>
    <mj-style>a { color: #2B579A; text-decoration: underline; }</mj-style>
  </mj-head>
  <mj-body background-color="#F5F5F5" width="600px">
    <mj-section padding="20px 24px"><mj-column><mj-text font-size="18px" font-weight="700" color="#2B579A">Votre marque</mj-text><mj-text color="#616161" font-size="12px" padding-top="0">Digest de la semaine</mj-text></mj-column></mj-section>
    <mj-section padding="20px 24px"><mj-column><mj-text font-size="18px" font-weight="700">Cette semaine</mj-text><mj-text>Les quatre lectures à ne pas manquer, sélectionnées par notre équipe.</mj-text></mj-column></mj-section>
    <mj-section padding="6px 24px"><mj-column width="12%"><mj-text font-size="22px" font-weight="700" color="#2B579A">1</mj-text></mj-column><mj-column width="88%"><mj-text font-weight="700">Titre du premier article</mj-text><mj-text padding-top="0">Une phrase pour donner envie de cliquer.</mj-text></mj-column></mj-section>
    <mj-section padding="6px 24px"><mj-column width="12%"><mj-text font-size="22px" font-weight="700" color="#2B579A">2</mj-text></mj-column><mj-column width="88%"><mj-text font-weight="700">Titre du deuxième article</mj-text><mj-text padding-top="0">Une phrase pour donner envie de cliquer.</mj-text></mj-column></mj-section>
    <mj-section padding="6px 24px"><mj-column width="12%"><mj-text font-size="22px" font-weight="700" color="#2B579A">3</mj-text></mj-column><mj-column width="88%"><mj-text font-weight="700">Titre du troisième article</mj-text><mj-text padding-top="0">Une phrase pour donner envie de cliquer.</mj-text></mj-column></mj-section>
    <mj-section padding="6px 24px"><mj-column width="12%"><mj-text font-size="22px" font-weight="700" color="#2B579A">4</mj-text></mj-column><mj-column width="88%"><mj-text font-weight="700">Titre du quatrième article</mj-text><mj-text padding-top="0">Une phrase pour donner envie de cliquer.</mj-text></mj-column></mj-section>
    <mj-section padding="12px 24px 28px"><mj-column><mj-button href="#">Tout lire sur le blog</mj-button></mj-column></mj-section>
    <mj-section background-color="#F5F5F5" padding="16px 24px"><mj-column><mj-text align="center" color="#616161" font-size="12px">Votre marque · Adresse postale de votre entreprise</mj-text><mj-text align="center" color="#616161" font-size="12px" padding-top="0">Vous recevez cet e-mail car vous êtes inscrit(e) à nos communications. <a href="{{unsubscribe_url}}">Se désabonner</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
