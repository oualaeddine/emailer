<mjml lang="fr">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif"></mj-all>
      <mj-text color="#242424" font-size="14px" line-height="1.5"></mj-text>
      <mj-section background-color="#FFFFFF"></mj-section>
      <mj-button background-color="#D83B01" color="#FFFFFF" border-radius="4px" font-weight="600"></mj-button>
    </mj-attributes>
    <mj-style>a { color: #D83B01; text-decoration: underline; }</mj-style>
  </mj-head>
  <mj-body background-color="#F5F5F5" width="600px">
    <mj-section padding="20px 24px"><mj-column><mj-text font-size="18px" font-weight="700" color="#D83B01">Votre marque</mj-text><mj-text color="#616161" font-size="12px" padding-top="0">Nouveauté</mj-text></mj-column></mj-section>
    <mj-section background-color="#FDF1EC" padding="32px 24px"><mj-column><mj-text color="#D83B01" font-size="12px" font-weight="700" text-transform="uppercase" letter-spacing="1px">Disponible dès maintenant</mj-text><mj-text font-size="28px" font-weight="700" line-height="1.25">Découvrez notre nouveau produit</mj-text><mj-text font-size="16px">Pensé pour vous simplifier la vie, il arrive enfin. Voyez ce qui le rend unique.</mj-text><mj-button href="#">Découvrir le produit</mj-button></mj-column></mj-section>
    <mj-section padding="12px 12px"><mj-column><mj-text font-weight="700">Simple</mj-text><mj-text>Prise en main immédiate.</mj-text></mj-column><mj-column><mj-text font-weight="700">Fiable</mj-text><mj-text>Conçu pour durer.</mj-text></mj-column><mj-column><mj-text font-weight="700">Abordable</mj-text><mj-text>Un prix pensé pour vous.</mj-text></mj-column></mj-section>
    <mj-section padding="12px 24px"><mj-column border-left="4px solid #D83B01"><mj-text font-size="18px" font-style="italic">« Un produit qui tient toutes ses promesses. »</mj-text><mj-text color="#616161" padding-top="0">— Un client satisfait</mj-text></mj-column></mj-section>
    <mj-section padding="12px 24px 28px"><mj-column><mj-button href="#">Commander maintenant</mj-button></mj-column></mj-section>
    <mj-section background-color="#F5F5F5" padding="16px 24px"><mj-column><mj-text align="center" color="#616161" font-size="12px">Votre marque · Adresse postale de votre entreprise</mj-text><mj-text align="center" color="#616161" font-size="12px" padding-top="0">Vous recevez cet e-mail car vous êtes inscrit(e) à nos communications. <a href="{{unsubscribe_url}}">Se désabonner</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
