<mjml lang="fr">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif"></mj-all>
      <mj-text color="#242424" font-size="14px" line-height="1.5"></mj-text>
      <mj-section background-color="#FFFFFF"></mj-section>
      <mj-button background-color="#107C10" color="#FFFFFF" border-radius="4px" font-weight="600"></mj-button>
    </mj-attributes>
    <mj-style>a { color: #107C10; text-decoration: underline; }</mj-style>
  </mj-head>
  <mj-body background-color="#F5F5F5" width="600px">
    <mj-section padding="20px 24px"><mj-column><mj-text font-size="18px" font-weight="700" color="#107C10">Votre marque</mj-text></mj-column></mj-section>
    <mj-section background-color="#EAF6EA" padding="32px 24px"><mj-column><mj-text color="#107C10" font-size="12px" font-weight="700" text-transform="uppercase" letter-spacing="1px">Bienvenue</mj-text><mj-text font-size="28px" font-weight="700" line-height="1.25">Ravi de vous compter parmi nous</mj-text><mj-text font-size="16px">Voici comment démarrer en quelques minutes.</mj-text><mj-button href="#">Commencer</mj-button></mj-column></mj-section>
    <mj-section padding="12px 12px 4px"><mj-column><mj-text font-size="18px" font-weight="700">Pour bien démarrer</mj-text></mj-column></mj-section>
    <mj-section padding="0 12px 12px"><mj-column><mj-text font-size="22px" font-weight="700" color="#107C10">1</mj-text><mj-text font-weight="700" padding-top="0">Complétez votre profil</mj-text><mj-text>Ajoutez vos informations pour une expérience personnalisée.</mj-text></mj-column><mj-column><mj-text font-size="22px" font-weight="700" color="#107C10">2</mj-text><mj-text font-weight="700" padding-top="0">Explorez nos services</mj-text><mj-text>Découvrez ce que nous pouvons faire pour vous.</mj-text></mj-column><mj-column><mj-text font-size="22px" font-weight="700" color="#107C10">3</mj-text><mj-text font-weight="700" padding-top="0">Contactez-nous</mj-text><mj-text>Notre équipe répond à vos questions.</mj-text></mj-column></mj-section>
    <mj-section padding="12px 24px 28px"><mj-column><mj-button href="#">Accéder à mon espace</mj-button></mj-column></mj-section>
    <mj-section background-color="#F5F5F5" padding="16px 24px"><mj-column><mj-text align="center" color="#616161" font-size="12px">Votre marque · Adresse postale de votre entreprise</mj-text><mj-text align="center" color="#616161" font-size="12px" padding-top="0">Vous recevez cet e-mail car vous êtes inscrit(e) à nos communications. <a href="{{unsubscribe_url}}">Se désabonner</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
